{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_" }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@prisma/client",
            "message": "Import Prisma only inside *.repository.ts files (see docs/01_Architecture/02_Feature_Architecture.md)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.repository.ts", "prisma/seed.ts", "prisma/verus/*.ts", "src/shared/lib/db.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
