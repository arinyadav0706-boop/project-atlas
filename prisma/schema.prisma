// Canonical source: docs/03_Database/01_Database_Design.md
// This file must match that document. Do not add a table/field/relation
// here without updating the doc first (CLAUDE.md rule 2).
//
// Audit fields (createdAt/updatedAt/createdBy/updatedBy/deletedAt) are
// modeled as plain scalar columns, not Prisma relations, to avoid an
// unmanageable number of named back-relations on User (every audited
// model would otherwise need two: "<Model>CreatedBy"/"<Model>UpdatedBy").
// They are intentionally soft references (informational actor id), not
// DB-enforced foreign keys — see Database Design §1.
//
// Full-text search (Database Design §5: GIN index over tsvector for Issue
// title/description and Project name) is added via a raw-SQL follow-up
// migration in Phase 4 (search module) — Prisma's declarative schema
// cannot express a computed tsvector + GIN index directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — used at runtime. Vercel's serverless
  // functions open far more short-lived connections than a normal server;
  // a direct connection exhausts Supabase's connection limit fast.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`.
  // PgBouncer's pooling breaks the session-level locking migrations rely
  // on, so Migrate needs to bypass the pooler.
  directUrl = env("DIRECT_URL")
}

// ---------- Enums (Database Design §3) ----------

enum OrgRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AuthProvider {
  GOOGLE
  MICROSOFT_ENTRA
  CREDENTIALS
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  /// Second hierarchy level (ADR-0045). Always paired with a non-null
  /// `parentId` — the two are kept in step by a CHECK constraint, not just by
  /// the service, because a SUBTASK with no parent is a row no query knows how
  /// to interpret.
  SUBTASK
}

/// The CATEGORY a status belongs to — not the status itself (ADR-0049 §1).
///
/// Renamed from `IssueStatus` when statuses became per-project data. Nothing
/// downstream asks "is this status called Done"; it asks "is it in the done
/// category", which is why 64 comparison sites across the product kept working
/// unchanged through that migration. Teams add statuses; the categories are
/// fixed, because a user-defined category would mean nothing to the reports,
/// metrics, dependency guard and roll-ups that reason about them.
enum StatusCategory {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// What starts an automation rule (ADR-0050 §1). Every one is a thing a PERSON
/// did — scheduled triggers need a scheduler and are future scope.
enum AutomationTrigger {
  ISSUE_CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
}

/// The outcome of one rule evaluation (ADR-0050 §6). SKIPPED is recorded on
/// purpose: "why didn't my rule fire" is the more common question, and without
/// the skip record it is unanswerable.
enum AutomationRunOutcome {
  SUCCESS
  SKIPPED
  FAILED
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  STATUS_CHANGED
  COMMENT_ADDED
  /// A blocker finished and you are no longer waiting (ADR-0046 §6). Its own
  /// type, not a STATUS_CHANGED on someone else's issue: the recipient does
  /// not care that VWP-12 moved, they care that THEIR issue can now start.
  UNBLOCKED
  /// An automation rule's `NOTIFY` action (ADR-0050). Its own type because the
  /// follow-up question — "who decided that?" — has a different answer.
  AUTOMATION
}

enum NotificationEntityType {
  ISSUE
  COMMENT
  SPRINT
}

// Home personalization (ADR-0012). Generic entity-type enums so RecentItem /
// Favorite extend to new entities without a schema change to the consumer.
enum RecentEntityType {
  ISSUE
  PROJECT
}

enum FavoriteEntityType {
  PROJECT
}

// Engagement weighting for the "Continue working" ranking (02_home.md BR-3):
// active work (EDITED/COMMENTED/TRANSITIONED) outranks passive VIEWED.
enum InteractionType {
  VIEWED
  ASSIGNED
  MENTIONED
  COMMENTED
  TRANSITIONED
  EDITED
}

// ---------- Entities (Database Design §2) ----------

model Organization {
  id     String @id @default(cuid())
  name   String
  domain String

  // Working-time basis for every capacity metric (ADR-0034 amendment). A
  // 6-day/8-hour company and a 5-day/9-hour company must not share one
  // hardcoded week, and EAGLES is sold to both. Weekly capacity =
  // workingMinutesPerDay × workingDaysPerWeek. Defaults to a 40-hour week, so
  // the column is purely additive for existing rows.
  workingMinutesPerDay Int @default(480)
  workingDaysPerWeek   Int @default(5)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  users        User[]
  projects     Project[]
  savedViews   SavedView[]
  customFields CustomFieldDefinition[]
  dashboards   Dashboard[]
  issueLinks   IssueLink[]
  labels       Label[]
  auditLogs    AuditLog[]
  featureFlags FeatureFlag[]
  teams        Team[]
  apiTokens    ApiToken[]
  webhooks     Webhook[]

  @@map("organizations")
}

// The people axis (ADR-0031, docs/02_Modules/20_teams.md): a reporting team with
// an optional manager and optional parent (nesting). Orthogonal to ProjectMember.
model Team {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  name           String
  managerId      String?
  manager        User?            @relation("TeamManager", fields: [managerId], references: [id])
  parentTeamId   String?
  parentTeam     Team?            @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams     Team[]           @relation("TeamHierarchy")
  memberships    TeamMembership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organizationId, deletedAt])
  @@index([parentTeamId])
  @@index([managerId])
  @@map("teams")
}

// Team membership link (ADR-0031). One team per user in V2 (unique userId).
// A pure link row: it carries who/when added, but removal is a HARD delete
// (audited in AuditLog) so the unique(userId) stays clean for re-adds — an
// explicit, documented exception to soft-delete (CLAUDE.md rule 9).
model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  user      User     @relation("TeamMembershipUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model User {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  email                String       @unique
  name                 String
  avatarUrl            String?
  passwordHash         String?
  orgRole              OrgRole      @default(MEMBER)
  isActive             Boolean      @default(true)
  lastLoginAt          DateTime?
  notificationsEnabled Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  authAccounts       AuthAccount[]
  projectMemberships ProjectMember[]
  assignedIssues     Issue[]          @relation("IssueAssignee")
  reportedIssues     Issue[]          @relation("IssueReporter")
  ledComponents      Component[]      @relation("ComponentLead")
  comments           Comment[]
  commentMentions    CommentMention[]
  attachments        Attachment[]
  notifications      Notification[]
  recentItems        RecentItem[]
  favorites          Favorite[]
  workLogs           WorkLog[]        @relation("WorkLogUser")
  savedViews         SavedView[]      @relation("SavedViewOwner")
  dashboards         Dashboard[]      @relation("DashboardOwner")
  managedTeams       Team[]           @relation("TeamManager")
  teamMemberships    TeamMembership[] @relation("TeamMembershipUser")
  recurrences        RecurringIssue[] @relation("RecurrenceReporter")
  apiTokens          ApiToken[]       @relation("ApiTokenOwner")
  recurrenceTargets  RecurringIssue[] @relation("RecurrenceAssignee")

  @@index([organizationId])
  @@map("users")
}

// Time tracking (ADR-0030, docs/02_Modules/19_time_tracking.md). A record of
// time actually spent on an issue by one user. Minutes (int, exact); workDate is
// the day the work was done (distinct from createdAt). Soft-deleted + OCC like
// comments. Estimate lives on Issue.estimateMinutes.
model WorkLog {
  id       String   @id @default(cuid())
  issueId  String
  issue    Issue    @relation(fields: [issueId], references: [id])
  userId   String
  user     User     @relation("WorkLogUser", fields: [userId], references: [id])
  minutes  Int
  workDate DateTime @db.Date
  note     String?
  version  Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([issueId, deletedAt])
  @@index([userId, workDate])
  @@map("work_logs")
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Project {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id])
  key                String
  name               String
  description        String?
  status             ProjectStatus @default(ACTIVE)
  issueKeyCounter    Int           @default(0)
  /// Restricted transitions (30_workflow BR-10). Off by default: ClickUp and
  /// Asana let you move anything anywhere, and Jira's transition graph is the
  /// reason "why can't I move this ticket" is a support category.
  enforceTransitions Boolean       @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  members        ProjectMember[]
  sprints        Sprint[]
  issues         Issue[]
  components     Component[]
  customFields   ProjectCustomField[]
  statuses       WorkflowStatus[]
  transitions    StatusTransition[]
  automations    AutomationRule[]
  automationRuns AutomationRun[]
  recurrences    RecurringIssue[]

  @@unique([organizationId, key])
  @@map("projects")
}

/// A status a team defined for one project (ADR-0049, 30_workflow).
///
/// Per-project rather than per-organization, and deliberately without Jira's
/// scheme indirection: schemes are the right answer at governance scale and the
/// most complained-about part of Jira administration. A nullable `schemeId` can
/// be added later without moving a row (backlog WF-3).
model WorkflowStatus {
  id             String         @id @default(cuid())
  /// Denormalised so a tenant-scoped query never needs the project join (F-1).
  organizationId String
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  name           String
  category       StatusCategory
  /// A design-token name, never a hex value — both themes have to keep working.
  color          String
  position       Int
  /// Exactly one per project; new issues get it (BR-5).
  isDefault      Boolean        @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues          Issue[]
  transitionsFrom StatusTransition[] @relation("TransitionFrom")
  transitionsTo   StatusTransition[] @relation("TransitionTo")

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("workflow_statuses")
}

/// One automation rule: a trigger, some conditions, some actions (ADR-0050).
///
/// Per project, like statuses, and for the same reasons — no scheme
/// indirection, no join to answer "what automates this project", and a nullable
/// scope can widen it later without moving a row (backlog AUT-4).
/// A personal access token for the public API (ADR-0052 §2).
///
/// Acts as its owner and can never exceed them (BR-2): every call resolves an
/// Actor and goes through the permission engine, so scopes narrow and never
/// widen what the person could already do.
model ApiToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// The token acts as this person.
  userId         String
  user           User         @relation("ApiTokenOwner", fields: [userId], references: [id])
  name           String
  /// The lookup half of `eag_<publicId>_<secret>`. Indexed, not secret: without
  /// it, verifying a token means hashing against every row in the table.
  publicId       String       @unique
  /// SHA-256 of the secret half, shown exactly once at creation and
  /// unrecoverable after (BR-4). A token store that can display its own secrets
  /// is a breach waiting for one bad export.
  secretHash     String
  scopes         String[]
  /// An API surface with no way to answer "is this still in use" cannot be
  /// safely cleaned up (BR-14).
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("api_tokens")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// An outbound webhook (ADR-0052 §7-§9). Per organization, managed by an org
/// ADMIN.
model Webhook {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  url                 String
  /// The receiver's half of the HMAC. Shown once, like a token secret — but
  /// stored in the clear because signing REQUIRES the original bytes, unlike a
  /// token which only ever needs to be compared.
  secret              String
  /// `resource.action` names (BR-11).
  events              String[]
  active              Boolean      @default(true)
  /// Reset on any success. Ten in a row switches the webhook off (BR-10).
  consecutiveFailures Int          @default(0)
  /// Why it was auto-disabled. Disabled rather than deleted, so the
  /// configuration survives to be fixed and re-enabled.
  disabledReason      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

/// One attempt-tracked delivery (BR-9).
///
/// A row rather than an in-process retry loop: the request that produced the
/// event has already returned, and the retry has to survive the process ending.
/// The existing scheduler tick (ADR-0051) drains this.
model WebhookDelivery {
  id            String                @id @default(cuid())
  webhookId     String
  /// Cascade, explicitly: a delivery is meaningless without the webhook it
  /// belongs to, and Prisma's default for a required relation is Restrict —
  /// which would not match the SQL and would block a hard delete forever.
  /// Webhooks are soft-deleted anyway, so this only ever fires on a manual one.
  webhook       Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  /// When the scheduler should try again; null once settled.
  nextAttemptAt DateTime?
  responseCode  Int?
  error         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The scheduler's only read: what is pending and due.
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

enum RecurrenceMode {
  /// Fires on the calendar regardless of the last instance.
  FIXED_SCHEDULE
  /// Fires `intervalDays` after the previous instance reaches a DONE category.
  AFTER_COMPLETION
}

/// No YEARLY: monthly with an interval of 12 IS yearly, and of 3 is
/// quarterly. One fewer frequency is one fewer thing to get wrong, and every
/// real cadence a team has is still expressible (rule 10).
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// A template plus a schedule (ADR-0051, 32_recurring.md). Each firing stamps
/// out a NEW issue — never reopens one, because cycle time and velocity replay
/// from status transitions and a row completed fifty-two times has no cycle
/// time at all (BR-1).
model RecurringIssue {
  id             String              @id @default(cuid())
  /// Denormalised so a tenant-scoped query never needs the project join (F-1).
  organizationId String
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id])
  name           String
  /// Paused by hand, or ended by its own end condition (BR-11).
  active         Boolean             @default(true)
  mode           RecurrenceMode      @default(FIXED_SCHEDULE)
  frequency      RecurrenceFrequency @default(WEEKLY)
  /// Every N days/weeks/months/years.
  interval       Int                 @default(1)
  /// The day the schedule is measured from. Every interval is counted from
  /// here, so "every 3 days" and "every other Tuesday" have a defined answer,
  /// and a recurrence can be set up today to begin next month.
  startsOn       DateTime
  /// WEEKLY: which days fire (0=Sunday … 6=Saturday).
  weekdays       Int[]
  /// MONTHLY/YEARLY: clamped to the month's length, so the 31st still fires in
  /// February rather than skipping the month.
  dayOfMonth     Int?
  /// Local time of day as minutes past midnight, read in `timeZone`.
  timeOfDay      Int                 @default(540)
  /// IANA zone. Per recurrence, not per org: "every Monday at 9" across three
  /// continents has no single right answer (ADR-0051 §7).
  timeZone       String              @default("UTC")
  /// DAILY only — never land on a Saturday or Sunday.
  skipWeekends   Boolean             @default(false)
  /// FIXED_SCHEDULE only. Without it, a daily task nobody does becomes thirty
  /// identical open issues (BR-6).
  skipIfOpen     Boolean             @default(false)
  /// AFTER_COMPLETION only — days after the previous instance is done.
  intervalDays   Int?

  // ── The template stamped out each time ──
  title       String
  description String?
  type        IssueType     @default(TASK)
  priority    IssuePriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?         @relation("RecurrenceAssignee", fields: [assigneeId], references: [id])
  /// Who the created issues are reported by (BR-8). A real person, because
  /// "who do I ask about this" must have an answer.
  reporterId  String
  reporter    User          @relation("RecurrenceReporter", fields: [reporterId], references: [id])
  /// Days from creation to the new issue's due date. Null = no due date.
  dueInDays   Int?

  // ── State ──
  /// Null once the recurrence has ended (BR-11). Indexed: the scheduler tick
  /// reads exactly this column across every project in the deployment.
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  occurrences    Int       @default(0)
  endsOn         DateTime?
  maxOccurrences Int?
  /// Why the last occurrence failed, if it did. A stuck schedule that silently
  /// produces nothing is worse than a gap (BR-13).
  lastError      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues Issue[] @relation("RecurrenceIssues")

  @@index([nextRunAt])
  @@index([projectId])
  @@map("recurring_issues")
}

model AutomationRule {
  id             String            @id @default(cuid())
  /// Denormalised so a tenant-scoped query never needs the project join (F-1).
  organizationId String
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id])
  name           String
  /// Disabling is the safe alternative to deleting (BR-10).
  enabled        Boolean           @default(true)
  trigger        AutomationTrigger
  /// Zod-validated documents, not one table per condition/action type
  /// (ADR-0050 §7). The database cannot police the shape, so every read and
  /// every write parses them; a rule that no longer parses is reported broken
  /// rather than executed on a guess.
  conditions     Json
  actions        Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  runs     AutomationRun[]
  comments Comment[]

  @@index([projectId, enabled])
  @@map("automation_rules")
}

/// One evaluation of one rule (ADR-0050 §6).
///
/// Jira's rule audit log is the difference between "the tool is haunted" and
/// "rule 3 did that at 14:02", so every outcome is recorded — including the
/// skips.
model AutomationRun {
  id         String               @id @default(cuid())
  ruleId     String
  rule       AutomationRule       @relation(fields: [ruleId], references: [id])
  projectId  String
  project    Project              @relation(fields: [projectId], references: [id])
  /// Null only for a run that failed before it resolved an issue.
  issueId    String?
  outcome    AutomationRunOutcome
  /// One human sentence: what changed, which condition stopped it, or why it
  /// failed. The run log is read by people, not by code.
  detail     String
  durationMs Int
  createdAt  DateTime             @default(now())

  @@index([ruleId, createdAt])
  @@index([projectId, createdAt])
  @@map("automation_runs")
}

/// One allowed move, when a project turns enforcement on (BR-10).
model StatusTransition {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
  fromStatusId String
  fromStatus   WorkflowStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id])
  toStatusId   String
  toStatus     WorkflowStatus @relation("TransitionTo", fields: [toStatusId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([fromStatusId, toStatusId])
  @@index([projectId])
  @@map("status_transitions")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole @default(MEMBER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  // Order of the PLANNED sprint queue on the backlog page (ADR-0015 / FUT-8).
  // Small integer position, reindexed on reorder (few sprints per project);
  // ACTIVE always sorts first regardless. createdAt is the tiebreaker.
  position  Int          @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues Issue[]

  @@index([projectId, status])
  @@map("sprints")
}

model Issue {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  key             String
  type            IssueType
  title           String
  description     String?
  /// The CATEGORY of this issue's status, denormalised from `statusId`
  /// (30_workflow BR-2). It must always equal `workflowStatus.category`; the
  /// service writes both in one update and an integration test pins it.
  ///
  /// Denormalised deliberately: the alternative is a join on every list query
  /// in the product, and this column is read by the board, the backlog, every
  /// report and metric, the dependency guard and the subtask roll-up.
  status          StatusCategory  @default(TODO)
  /// The project-defined status a human sees (ADR-0049 §1).
  statusId        String
  workflowStatus  WorkflowStatus  @relation(fields: [statusId], references: [id])
  priority        IssuePriority   @default(MEDIUM)
  assigneeId      String?
  assignee        User?           @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporterId      String
  reporter        User            @relation("IssueReporter", fields: [reporterId], references: [id])
  sprintId        String?
  sprint          Sprint?         @relation(fields: [sprintId], references: [id])
  epicId          String?
  epic            Issue?          @relation("EpicChildren", fields: [epicId], references: [id])
  children        Issue[]         @relation("EpicChildren")
  /// Parent of a SUBTASK, and only of a SUBTASK (ADR-0045 §2). Deliberately a
  /// SECOND pointer alongside `epicId` rather than a reuse of it: `epicId` is
  /// the Story→Epic link with its own rule set, and collapsing both into one
  /// column whose meaning depends on the row's type is the worst of both. No
  /// row ever carries both. Jira unified the two in 2023; that is tracked as
  /// backlog ST-7, not smuggled in here.
  parentId        String?
  parent          Issue?          @relation("Subtasks", fields: [parentId], references: [id])
  subtasks        Issue[]         @relation("Subtasks")
  storyPoints     Int?
  // String fractional rank (LexoRank-style, base-62) for board/backlog order.
  // Assigned via `fractional-indexing`; a reorder writes one row, no rebalance
  // (ADR-0009). Ordering space is per (projectId, status) column.
  // The column is pinned to `COLLATE "C"` (byte ordering) by migration
  // 20260720000000_rank_collation — the base-62 keys only sort correctly under
  // byte order. Prisma can't express collation in-schema, so it lives in that
  // migration and Prisma leaves it untouched. See 06_Portability_Boundary.md.
  rank            String
  // Optimistic concurrency control (ADR-0011). Every mutation increments this;
  // a conditional write (WHERE version = expected) detects a lost update — two
  // people changing the same card — and rejects the stale one instead of
  // silently overwriting. O(1) per write, no locks; scales to any user count.
  version         Int             @default(0)
  dueDate         DateTime?
  /// The Timeline bar's left edge (ADR-0047 §1); `dueDate` is its right.
  ///
  /// A separate column rather than something derived: the sprint would draw
  /// every bar the same length, and `createdAt` — when somebody typed it in —
  /// is not when the work starts. Nullable, because most issues are a deadline
  /// with no planned start, which the chart renders as a one-day bar.
  startDate       DateTime?
  // Original effort estimate in MINUTES (ADR-0030, time-tracking feature). Owned
  // by the time-tracking service, not the issue-edit path; not OCC-bound.
  estimateMinutes Int?
  /// The recurrence that created this issue (ADR-0051 §9). A back-pointer
  /// rather than a log table: a recurrence that fires produces an issue, and
  /// the issue IS the record.
  recurrenceId    String?
  recurrence      RecurringIssue? @relation("RecurrenceIssues", fields: [recurrenceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  comments          Comment[]
  attachments       Attachment[]
  labels            IssueLabel[]
  components        IssueComponent[]
  workLogs          WorkLog[]
  customFieldValues CustomFieldValue[]
  /// Dependencies (ADR-0046). Two back-relations for ONE table: a link is
  /// stored once as source→target and read from both ends. The inverse is
  /// derived, never a second row — that is how a link table drifts into
  /// "A blocks B" while B is blocked by nothing.
  linksOut          IssueLink[]        @relation("LinkSource")
  linksIn           IssueLink[]        @relation("LinkTarget")

  @@unique([projectId, key])
  // Covers the board/list query (filter by projectId[,status] + sort by rank)
  // AND enforces collision-free ordering: ranks are unique per (project,status)
  // column (ADR-0010). Duplicates are already impossible by construction (each
  // key carries a random suffix — see rank.ts); this is the loud backstop.
  @@unique([projectId, status, rank])
  // Backlog query: WHERE projectId, sprintId IS NULL ORDER BY rank (ADR-0013).
  @@index([projectId, sprintId, rank])
  @@index([sprintId])
  // Dashboard "my open issues": filter by assignee, narrow by status. The
  // assignee prefix still serves assignee-only lookups.
  @@index([assigneeId, status])
  // A parent's subtasks (ADR-0045): read on every parent detail page, and by
  // the cascade on delete and the sprint follow-the-parent move.
  @@index([parentId])
  // Timeline (ADR-0047): the chart reads one project's dated issues ordered by
  // start. Covers both the filter and the sort.
  @@index([projectId, startDate])
  @@index([statusId])
  @@index([recurrenceId])
  @@map("issues")
}

/// The ORDERING relationship between issues (ADR-0046), as opposed to the two
/// containment ones an Issue already carries (`epicId`, `parentId`).
enum IssueLinkType {
  /// Directional: source blocks target ⇒ target is blocked by source.
  BLOCKS
  /// Symmetric. Normalised so the smaller id is always the source, or "A
  /// relates to B" and "B relates to A" become two rows the unique index
  /// cannot see are one fact.
  RELATES_TO
  /// Directional: source duplicates target.
  DUPLICATES
}

/// One typed link between two issues, stored ONCE and read from both ends
/// (ADR-0046 §2). Links may cross projects inside one organisation — a tool
/// that can only express within-project blocking cannot describe the
/// dependencies that actually hurt.
model IssueLink {
  id String @id @default(cuid())

  /// Denormalised so a tenant-scoped read never has to join two issues to two
  /// projects to two organisations. Both endpoints are always in this org.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  sourceId String
  source   Issue  @relation("LinkSource", fields: [sourceId], references: [id])
  targetId String
  target   Issue  @relation("LinkTarget", fields: [targetId], references: [id])

  type IssueLinkType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  /// One fact, one row (BR-4). Symmetric types are direction-normalised before
  /// the write, so this index catches their duplicates too.
  @@unique([sourceId, targetId, type])
  /// "What blocks me" — the inverse read, which is the common one.
  @@index([targetId, type])
  @@index([sourceId, type])
  @@index([organizationId])
  @@map("issue_links")
}

model Label {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  color          String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues IssueLabel[]

  // Case-insensitive uniqueness per org over LIVE rows is enforced by a
  // functional partial unique index (lower(name) WHERE deletedAt IS NULL) in
  // migration 20260723..._labels_components — Prisma can't express `lower()`
  // or a partial index in-schema, so the exact `@@unique` is dropped and the
  // constraint lives in that migration (ADR-0018 §2, BR-3). Prisma leaves the
  // raw index untouched.
  @@map("labels")
}

model IssueLabel {
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?

  @@id([issueId, labelId])
  @@map("issue_labels")
}

// Project-scoped sub-system of a project (ADR-0018, 18_components.md). A
// component may name a `lead`; adding it to an unassigned issue routes the
// issue to that lead (BR-3). Many-to-many with issues via IssueComponent.
model Component {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String
  description String?
  // Optional default owner. Soft reference to a User; kept as a real relation
  // (like Issue.assignee) so default-assignee routing can join it.
  leadId      String?
  lead        User?   @relation("ComponentLead", fields: [leadId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues IssueComponent[]

  // Case-insensitive uniqueness per project over live rows is enforced by a
  // functional partial unique index in the migration (same reason as Label).
  @@index([projectId])
  @@map("components")
}

model IssueComponent {
  issueId     String
  issue       Issue     @relation(fields: [issueId], references: [id])
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  createdAt   DateTime  @default(now())
  createdBy   String?

  @@id([issueId, componentId])
  @@index([componentId])
  @@map("issue_components")
}

// Body storage format (ADR-0016): the source is stored as-is and rendered per
// format, so a future rich-text editor changes the value + renderer, not the schema.
enum CommentBodyFormat {
  PLAIN
  MARKDOWN
}

model Comment {
  id               String            @id @default(cuid())
  issueId          String
  issue            Issue             @relation(fields: [issueId], references: [id])
  /// Null for a comment an automation rule posted (ADR-0050 §4). A rule is not
  /// a user and must not borrow one: attributing an automated comment to
  /// whoever tripped the trigger is the audit-log lie BR-3 exists to prevent,
  /// and a fake "Automation" user row would leak into every member picker,
  /// mention list and seat count in the product.
  authorId         String?
  // Restrict, explicitly: making the relation optional flips Prisma's default
  // to SetNull, which would leave a comment with neither an author nor a rule
  // and break the `comments_one_author` CHECK. The database has carried
  // RESTRICT since init; this keeps the schema saying so.
  author           User?             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  /// Set instead of `authorId` when a rule posted this. Exactly one of the two
  /// is present on every row.
  automationRuleId String?
  automationRule   AutomationRule?   @relation(fields: [automationRuleId], references: [id], onDelete: Restrict)
  // Threading backbone (ADR-0016). Present from day one; the MVP renders flat.
  parentCommentId  String?
  parentComment    Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies          Comment[]         @relation("CommentReplies")
  body             String
  bodyFormat       CommentBodyFormat @default(MARKDOWN)
  // "edited" indicator; null until the first edit.
  editedAt         DateTime?
  // Optimistic concurrency (ADR-0011): a version-checked edit rejects stale writes.
  version          Int               @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  mentions CommentMention[]

  // Ordered, keyset-paginated list per issue.
  @@index([issueId, createdAt])
  // Reply lookups + per-root reply counts (ADR-0038).
  @@index([parentCommentId, createdAt])
  // Top-level comments for an issue: the list query filters on all three.
  @@index([issueId, parentCommentId, createdAt])
  @@map("comments")
}

// Who a comment mentions (ADR-0038 §1).
//
// A derived index, not the source of truth — the body is, via its
// `@[Name](user:id)` tokens. This exists so "notify the mentioned" and "show me
// my mentions" are indexed reads instead of a scan over comment text, and it is
// rebuilt from the body on every edit.
model CommentMention {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // One row per person per comment, however many times they are named in it.
  @@unique([commentId, userId])
  // "Mentions of me", newest first.
  @@index([userId, createdAt])
  @@map("comment_mentions")
}

model Attachment {
  id           String @id @default(cuid())
  issueId      String
  issue        Issue  @relation(fields: [issueId], references: [id])
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([issueId])
  @@map("attachments")
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  type       NotificationType
  entityType NotificationEntityType
  entityId   String
  message    String
  isRead     Boolean                @default(false)
  readAt     DateTime?
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Serves the unread-count bell poll.
  @@index([userId, isRead])
  // Serves the history page's sort, which the index above cannot (PERF-9).
  @@index([userId, createdAt, id])
  @@map("notifications")
}

// Home personalization tables (ADR-0012, 02_home.md). Personal signals, not
// audited domain entities — like Notification they are an intentional exception
// to the audit-field convention (Database Design §1). Unstarring hard-deletes a
// Favorite (a preference row, not domain data), also an allowed exception.

// Implicit engagement signal powering "Continue working" and "recent projects".
// One row per (user, entity), upserted on interaction. Distinct from AuditLog:
// AuditLog is the immutable compliance record of *changes*; this is a mutable
// personal *navigation* signal (views included) — kept separate so views never
// bloat the audit log.
model RecentItem {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  entityType       RecentEntityType
  entityId         String
  interactionType  InteractionType
  lastInteractedAt DateTime         @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, lastInteractedAt(sort: Desc)])
  @@map("recent_items")
}

// Explicit user pin (starred projects now; extensible via entityType).
model Favorite {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  entityType FavoriteEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@map("favorites")
}

// Explicit exception to the audit-field convention: immutable, append-only
// (Database Design §1, §2.13). Dual-purpose — also stores
// ISSUE_STATUS_CHANGED entries powering the cycle-time report.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  // Per-entity activity timeline (e.g. one issue's history), newest first.
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// Admin control plane (ADR-0023, Database Design §2.16). Stores only explicit
// per-org overrides; the flag catalog is a typed code registry, so a flag with
// no row here takes its registry default. Gates behavior/visibility, never
// tenant isolation or RBAC.
// Fixed-window rate-limit counters (ADR-0028). Ephemeral operational state,
// NOT a domain entity: an explicit, documented exception to the audit-fields /
// soft-delete convention (CLAUDE.md rule 9) — rows are hard-deleted on expiry.
// `key` is "bucket:identifier:windowStart"; one row per window.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

model FeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  enabled        Boolean

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organizationId, key])
  @@map("feature_flags")
}

// ── Saved views (ADR-0040, docs/02_Modules/22_saved_views.md) ────────────────

enum SavedViewVisibility {
  PRIVATE
  SHARED
}

enum SavedViewSort {
  UPDATED_DESC
  UPDATED_ASC
  CREATED_DESC
  CREATED_ASC
  DUE_DATE_ASC
  DUE_DATE_DESC
  PRIORITY_DESC
  PRIORITY_ASC
  KEY_ASC
}

model SavedView {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User                @relation("SavedViewOwner", fields: [ownerId], references: [id])
  name           String
  /// A validated IssueFilter (ADR-0040 §3). JSON so that adding a filter field
  /// needs no migration; parsed with the same Zod schema as the query string on
  /// both write and read, so the shape is still enforced — just not by Postgres.
  filter         Json
  sort           SavedViewSort       @default(UPDATED_DESC)
  visibility     SavedViewVisibility @default(PRIVATE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  widgets DashboardWidget[]

  // BR-10 in the database rather than a check-then-insert, which races.
  @@unique([ownerId, name])
  // The list query: everything in my org that is shared, plus my own.
  @@index([organizationId, visibility, deletedAt])
  @@index([ownerId, deletedAt])
  @@map("saved_views")
}

// ── Custom fields (ADR-0042, docs/02_Modules/24_custom_fields.md) ────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  MULTI_SELECT
  USER
  URL
}

/// An org-level field definition. Projects opt in via ProjectCustomField —
/// one definition per concept, so "Customer" means the same thing everywhere
/// and stays reportable across projects (ADR-0042 §2).
model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  /// Immutable after creation: changing it would reinterpret every stored
  /// value. The API rejects a type change outright (BR-2).
  type           CustomFieldType
  description    String?
  required       Boolean         @default(false)

  options  CustomFieldOption[]
  projects ProjectCustomField[]
  values   CustomFieldValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organizationId, deletedAt])
  @@map("custom_field_definitions")
}

/// A SELECT / MULTI_SELECT choice. A row with an id, not a bare string, so
/// renaming a label preserves every value pointing at it (ADR-0042 §5).
model CustomFieldOption {
  id       String                @id @default(cuid())
  fieldId  String
  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id])
  label    String
  /// Explicit, so reordering does not depend on insertion order.
  position Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([fieldId, deletedAt])
  @@map("custom_field_options")
}

/// Which fields a project shows, and in what order (BR-5).
model ProjectCustomField {
  id        String                @id @default(cuid())
  projectId String
  project   Project               @relation(fields: [projectId], references: [id])
  fieldId   String
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id])
  position  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, fieldId])
  @@index([projectId])
  @@map("project_custom_fields")
}

/// One row per (issue, field), with exactly one typed column populated.
///
/// Typed columns rather than a JSON blob: values are user data that has to
/// outlive the field, be indexable, and keep referential integrity for select
/// options (ADR-0042 §1). `Decimal` rather than `Float` because a custom number
/// is as likely to be money as a count, and float rounding on money is a bug
/// that only surfaces in a report months later.
model CustomFieldValue {
  id      String                @id @default(cuid())
  issueId String
  issue   Issue                 @relation(fields: [issueId], references: [id])
  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id])

  valueText   String?
  valueNumber Decimal?  @db.Decimal(18, 4)
  valueDate   DateTime?
  valueBool   Boolean?
  valueUserId String?
  /// SELECT holds one, MULTI_SELECT holds many. Bounded by the option cap, so
  /// an array beats a third table and a third write per value.
  optionIds   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  /// Makes a write an upsert rather than a check-then-insert, which races.
  @@unique([issueId, fieldId])
  @@index([fieldId])
  @@map("custom_field_values")
}

// ── Dashboards (ADR-0044, docs/02_Modules/25_dashboards.md) ─────────────────

enum DashboardVisibility {
  PRIVATE
  SHARED
}

enum DashboardWidgetType {
  STAT
  BREAKDOWN
  LIST
}

enum DashboardWidgetWidth {
  SMALL
  MEDIUM
  LARGE
}

enum DashboardBreakdownBy {
  STATUS
  PRIORITY
  TYPE
  ASSIGNEE
}

/// Anyone's, not the admin's (ADR-0044 §1): no capability gates this, and
/// there is deliberately no org-wide default dashboard.
model Dashboard {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User                @relation("DashboardOwner", fields: [ownerId], references: [id])
  name           String
  visibility     DashboardVisibility @default(PRIVATE)

  widgets DashboardWidget[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([ownerId, name])
  @@index([organizationId, visibility, deletedAt])
  @@map("dashboards")
}

/// One lens on the issue query. It is a QUERY, not a stored result — nothing
/// here caches numbers, so a widget can never drift from the data.
model DashboardWidget {
  id          String               @id @default(cuid())
  dashboardId String
  dashboard   Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title       String
  type        DashboardWidgetType
  width       DashboardWidgetWidth @default(SMALL)
  position    Int

  /// Inline IssueFilter, re-validated on read. Ignored when `savedViewId` is
  /// set — a widget carries one or the other, never both (BR-4).
  filter      Json
  /// Read LIVE when present, so editing the view updates every widget using it.
  savedViewId String?
  savedView   SavedView?            @relation(fields: [savedViewId], references: [id])
  /// Required for BREAKDOWN, refused otherwise.
  breakdownBy DashboardBreakdownBy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dashboardId])
  @@map("dashboard_widgets")
}
