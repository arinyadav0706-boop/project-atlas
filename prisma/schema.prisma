// Canonical source: docs/03_Database/01_Database_Design.md
// This file must match that document. Do not add a table/field/relation
// here without updating the doc first (CLAUDE.md rule 2).
//
// Audit fields (createdAt/updatedAt/createdBy/updatedBy/deletedAt) are
// modeled as plain scalar columns, not Prisma relations, to avoid an
// unmanageable number of named back-relations on User (every audited
// model would otherwise need two: "<Model>CreatedBy"/"<Model>UpdatedBy").
// They are intentionally soft references (informational actor id), not
// DB-enforced foreign keys — see Database Design §1.
//
// Full-text search (Database Design §5: GIN index over tsvector for Issue
// title/description and Project name) is added via a raw-SQL follow-up
// migration in Phase 4 (search module) — Prisma's declarative schema
// cannot express a computed tsvector + GIN index directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — used at runtime. Vercel's serverless
  // functions open far more short-lived connections than a normal server;
  // a direct connection exhausts Supabase's connection limit fast.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`.
  // PgBouncer's pooling breaks the session-level locking migrations rely
  // on, so Migrate needs to bypass the pooler.
  directUrl = env("DIRECT_URL")
}

// ---------- Enums (Database Design §3) ----------

enum OrgRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AuthProvider {
  GOOGLE
  MICROSOFT_ENTRA
  CREDENTIALS
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  STATUS_CHANGED
  COMMENT_ADDED
}

enum NotificationEntityType {
  ISSUE
  COMMENT
  SPRINT
}

// Home personalization (ADR-0012). Generic entity-type enums so RecentItem /
// Favorite extend to new entities without a schema change to the consumer.
enum RecentEntityType {
  ISSUE
  PROJECT
}

enum FavoriteEntityType {
  PROJECT
}

// Engagement weighting for the "Continue working" ranking (02_home.md BR-3):
// active work (EDITED/COMMENTED/TRANSITIONED) outranks passive VIEWED.
enum InteractionType {
  VIEWED
  ASSIGNED
  MENTIONED
  COMMENTED
  TRANSITIONED
  EDITED
}

// ---------- Entities (Database Design §2) ----------

model Organization {
  id     String @id @default(cuid())
  name   String
  domain String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  users        User[]
  projects     Project[]
  labels       Label[]
  auditLogs    AuditLog[]
  featureFlags FeatureFlag[]
  teams        Team[]

  @@map("organizations")
}

// The people axis (ADR-0031, docs/02_Modules/20_teams.md): a reporting team with
// an optional manager and optional parent (nesting). Orthogonal to ProjectMember.
model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  managerId      String?
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id])
  parentTeamId   String?
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams     Team[]       @relation("TeamHierarchy")
  memberships    TeamMembership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organizationId, deletedAt])
  @@index([parentTeamId])
  @@index([managerId])
  @@map("teams")
}

// Team membership link (ADR-0031). One team per user in V2 (unique userId).
// A pure link row: it carries who/when added, but removal is a HARD delete
// (audited in AuditLog) so the unique(userId) stays clean for re-adds — an
// explicit, documented exception to soft-delete (CLAUDE.md rule 9).
model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  user      User     @relation("TeamMembershipUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model User {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  email                String       @unique
  name                 String
  avatarUrl            String?
  passwordHash         String?
  orgRole              OrgRole      @default(MEMBER)
  isActive             Boolean      @default(true)
  lastLoginAt          DateTime?
  notificationsEnabled Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  authAccounts       AuthAccount[]
  projectMemberships ProjectMember[]
  assignedIssues     Issue[]         @relation("IssueAssignee")
  reportedIssues     Issue[]         @relation("IssueReporter")
  ledComponents      Component[]     @relation("ComponentLead")
  comments           Comment[]
  attachments        Attachment[]
  notifications      Notification[]
  recentItems        RecentItem[]
  favorites          Favorite[]
  workLogs           WorkLog[]       @relation("WorkLogUser")
  managedTeams       Team[]          @relation("TeamManager")
  teamMemberships    TeamMembership[] @relation("TeamMembershipUser")

  @@index([organizationId])
  @@map("users")
}

// Time tracking (ADR-0030, docs/02_Modules/19_time_tracking.md). A record of
// time actually spent on an issue by one user. Minutes (int, exact); workDate is
// the day the work was done (distinct from createdAt). Soft-deleted + OCC like
// comments. Estimate lives on Issue.estimateMinutes.
model WorkLog {
  id       String   @id @default(cuid())
  issueId  String
  issue    Issue    @relation(fields: [issueId], references: [id])
  userId   String
  user     User     @relation("WorkLogUser", fields: [userId], references: [id])
  minutes  Int
  workDate DateTime @db.Date
  note     String?
  version  Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([issueId, deletedAt])
  @@index([userId, workDate])
  @@map("work_logs")
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Project {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  key             String
  name            String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  issueKeyCounter Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  members    ProjectMember[]
  sprints    Sprint[]
  issues     Issue[]
  components Component[]

  @@unique([organizationId, key])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole @default(MEMBER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  // Order of the PLANNED sprint queue on the backlog page (ADR-0015 / FUT-8).
  // Small integer position, reindexed on reorder (few sprints per project);
  // ACTIVE always sorts first regardless. createdAt is the tiebreaker.
  position  Int          @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues Issue[]

  @@index([projectId, status])
  @@map("sprints")
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  key         String
  type        IssueType
  title       String
  description String?
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporterId  String
  reporter    User          @relation("IssueReporter", fields: [reporterId], references: [id])
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id])
  epicId      String?
  epic        Issue?        @relation("EpicChildren", fields: [epicId], references: [id])
  children    Issue[]       @relation("EpicChildren")
  storyPoints Int?
  // String fractional rank (LexoRank-style, base-62) for board/backlog order.
  // Assigned via `fractional-indexing`; a reorder writes one row, no rebalance
  // (ADR-0009). Ordering space is per (projectId, status) column.
  // The column is pinned to `COLLATE "C"` (byte ordering) by migration
  // 20260720000000_rank_collation — the base-62 keys only sort correctly under
  // byte order. Prisma can't express collation in-schema, so it lives in that
  // migration and Prisma leaves it untouched. See 06_Portability_Boundary.md.
  rank        String
  // Optimistic concurrency control (ADR-0011). Every mutation increments this;
  // a conditional write (WHERE version = expected) detects a lost update — two
  // people changing the same card — and rejects the stale one instead of
  // silently overwriting. O(1) per write, no locks; scales to any user count.
  version     Int           @default(0)
  dueDate     DateTime?
  // Original effort estimate in MINUTES (ADR-0030, time-tracking feature). Owned
  // by the time-tracking service, not the issue-edit path; not OCC-bound.
  estimateMinutes Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  comments    Comment[]
  attachments Attachment[]
  labels      IssueLabel[]
  components  IssueComponent[]
  workLogs    WorkLog[]

  @@unique([projectId, key])
  // Covers the board/list query (filter by projectId[,status] + sort by rank)
  // AND enforces collision-free ordering: ranks are unique per (project,status)
  // column (ADR-0010). Duplicates are already impossible by construction (each
  // key carries a random suffix — see rank.ts); this is the loud backstop.
  @@unique([projectId, status, rank])
  // Backlog query: WHERE projectId, sprintId IS NULL ORDER BY rank (ADR-0013).
  @@index([projectId, sprintId, rank])
  @@index([sprintId])
  // Dashboard "my open issues": filter by assignee, narrow by status. The
  // assignee prefix still serves assignee-only lookups.
  @@index([assigneeId, status])
  @@map("issues")
}

model Label {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  color          String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues IssueLabel[]

  // Case-insensitive uniqueness per org over LIVE rows is enforced by a
  // functional partial unique index (lower(name) WHERE deletedAt IS NULL) in
  // migration 20260723..._labels_components — Prisma can't express `lower()`
  // or a partial index in-schema, so the exact `@@unique` is dropped and the
  // constraint lives in that migration (ADR-0018 §2, BR-3). Prisma leaves the
  // raw index untouched.
  @@map("labels")
}

model IssueLabel {
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?

  @@id([issueId, labelId])
  @@map("issue_labels")
}

// Project-scoped sub-system of a project (ADR-0018, 18_components.md). A
// component may name a `lead`; adding it to an unassigned issue routes the
// issue to that lead (BR-3). Many-to-many with issues via IssueComponent.
model Component {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String
  description String?
  // Optional default owner. Soft reference to a User; kept as a real relation
  // (like Issue.assignee) so default-assignee routing can join it.
  leadId      String?
  lead        User?   @relation("ComponentLead", fields: [leadId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  issues IssueComponent[]

  // Case-insensitive uniqueness per project over live rows is enforced by a
  // functional partial unique index in the migration (same reason as Label).
  @@index([projectId])
  @@map("components")
}

model IssueComponent {
  issueId     String
  issue       Issue     @relation(fields: [issueId], references: [id])
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  createdAt   DateTime  @default(now())
  createdBy   String?

  @@id([issueId, componentId])
  @@index([componentId])
  @@map("issue_components")
}

// Body storage format (ADR-0016): the source is stored as-is and rendered per
// format, so a future rich-text editor changes the value + renderer, not the schema.
enum CommentBodyFormat {
  PLAIN
  MARKDOWN
}

model Comment {
  id              String            @id @default(cuid())
  issueId         String
  issue           Issue             @relation(fields: [issueId], references: [id])
  authorId        String
  author          User              @relation(fields: [authorId], references: [id])
  // Threading backbone (ADR-0016). Present from day one; the MVP renders flat.
  parentCommentId String?
  parentComment   Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]         @relation("CommentReplies")
  body            String
  bodyFormat      CommentBodyFormat @default(MARKDOWN)
  // "edited" indicator; null until the first edit.
  editedAt        DateTime?
  // Optimistic concurrency (ADR-0011): a version-checked edit rejects stale writes.
  version         Int               @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // Ordered, keyset-paginated list per issue.
  @@index([issueId, createdAt])
  // Reply lookups (future threading).
  @@index([parentCommentId])
  @@map("comments")
}

model Attachment {
  id           String @id @default(cuid())
  issueId      String
  issue        Issue  @relation(fields: [issueId], references: [id])
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([issueId])
  @@map("attachments")
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  type       NotificationType
  entityType NotificationEntityType
  entityId   String
  message    String
  isRead     Boolean                @default(false)
  readAt     DateTime?
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

// Home personalization tables (ADR-0012, 02_home.md). Personal signals, not
// audited domain entities — like Notification they are an intentional exception
// to the audit-field convention (Database Design §1). Unstarring hard-deletes a
// Favorite (a preference row, not domain data), also an allowed exception.

// Implicit engagement signal powering "Continue working" and "recent projects".
// One row per (user, entity), upserted on interaction. Distinct from AuditLog:
// AuditLog is the immutable compliance record of *changes*; this is a mutable
// personal *navigation* signal (views included) — kept separate so views never
// bloat the audit log.
model RecentItem {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  entityType       RecentEntityType
  entityId         String
  interactionType  InteractionType
  lastInteractedAt DateTime         @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, lastInteractedAt(sort: Desc)])
  @@map("recent_items")
}

// Explicit user pin (starred projects now; extensible via entityType).
model Favorite {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  entityType FavoriteEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@map("favorites")
}

// Explicit exception to the audit-field convention: immutable, append-only
// (Database Design §1, §2.13). Dual-purpose — also stores
// ISSUE_STATUS_CHANGED entries powering the cycle-time report.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  // Per-entity activity timeline (e.g. one issue's history), newest first.
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// Admin control plane (ADR-0023, Database Design §2.16). Stores only explicit
// per-org overrides; the flag catalog is a typed code registry, so a flag with
// no row here takes its registry default. Gates behavior/visibility, never
// tenant isolation or RBAC.
// Fixed-window rate-limit counters (ADR-0028). Ephemeral operational state,
// NOT a domain entity: an explicit, documented exception to the audit-fields /
// soft-delete convention (CLAUDE.md rule 9) — rows are hard-deleted on expiry.
// `key` is "bucket:identifier:windowStart"; one row per window.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

model FeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  enabled        Boolean

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organizationId, key])
  @@map("feature_flags")
}
