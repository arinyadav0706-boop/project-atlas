# Copy to .env.local for development. Every var here is Zod-validated at
# startup in src/shared/lib/env.ts — see docs/06_Infrastructure/01_Infrastructure_Overview.md §4.

# Postgres connection string used at runtime (local Docker Compose Postgres
# on 5432, or Supabase's POOLED connection string on 6543 in dev/prod).
DATABASE_URL="postgresql://eagles:eagles@localhost:5432/eagles?schema=public"

# Direct, unpooled connection — used only by `prisma migrate`. Same as
# DATABASE_URL for local Docker Postgres (no pooler in front of it); on
# Supabase, use the DIRECT connection string (port 5432), not the pooled one.
DIRECT_URL="postgresql://eagles:eagles@localhost:5432/eagles?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth (ADR-0003)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID / OIDC (ADR-0003)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Comma-separated allowlist of email domains (ADR-0005). Two roles:
#   1. Sign-in restriction: when SET, any identity whose domain isn't listed is
#      rejected at sign-in.
#   2. SSO auto-provisioning gate (security finding F6): a NEW Google/Microsoft
#      user is auto-created ONLY if their domain is listed. When UNSET, SSO is
#      invite-only (existing users can sign in; unknown SSO users are rejected,
#      never auto-created) — fails closed, no open self-registration.
# Example once your org adopts EAGLES: ALLOWED_EMAIL_DOMAINS="consint.ai"
ALLOWED_EMAIL_DOMAINS=""

# Storage (Supabase Storage today; Azure Blob later, behind StorageAdapter — ADR-0004)
# PROD (GL-8): attachments/avatars need durable storage — the `local` default is
# ephemeral on serverless (files vanish between deploys). Set these in prod:
#   STORAGE_PROVIDER="supabase"
#   SUPABASE_URL="https://<project-ref>.supabase.co"
#   SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only secret
#   SUPABASE_STORAGE_BUCKET="attachments"            # create this bucket first (private)
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# Seed / bootstrap (prisma/seed.ts). The first admin is created from these — no
# credentials are hardcoded (GL-1). For PRODUCTION, set SEED_ADMIN_EMAIL and run
# with NODE_ENV=production SEED_DEMO=false so the shared-password demo team is
# never created:
#   SEED_ADMIN_EMAIL="you@org.com"
#   SEED_ADMIN_PASSWORD="<strong-password>"   # omit for an SSO-only admin
#   SEED_ADMIN_NAME="Your Name"
# Leave unset for local dev — a placeholder admin (admin@eagles.local) + the demo
# team seed automatically. SEED_DEMO="true"/"false" forces the demo team on/off.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
# Per-file upload ceiling in BYTES. Default 4 MB (4000000). Keep it under the
# host's request-body limit while uploads pass THROUGH the app (many serverless
# platforms cap request bodies at ~4.5 MB). Raise it once direct-to-storage
# upload is enabled (ADR-0017 §4), where files bypass the app server entirely.
ATTACHMENT_MAX_BYTES="4000000"

# Recurring issues (ADR-0051 §5). A shared secret for POST /api/scheduler/tick,
# sent as `Authorization: Bearer <secret>`. Any scheduler can call it — Vercel
# Cron, a Kubernetes CronJob, a systemd timer, GitHub Actions — so nothing here
# is a bet on the current host. Hourly is the intended cadence; the endpoint is
# idempotent, so calling it more often is harmless.
#   PROD: set this. While it is EMPTY the endpoint refuses every request, and
#   recurring issues therefore never fire.
SCHEDULER_SECRET=""
# On Vercel, set this INSTEAD: Vercel Cron sends `Authorization: Bearer
# $CRON_SECRET` with each scheduled GET, and the route accepts it as an alias,
# so there is only one value to manage.
CRON_SECRET=""
